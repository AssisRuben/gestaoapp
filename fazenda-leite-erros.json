        "jsCode": "const erro = $('Error Trigger').first().json;\nlet remetente = null;\ntry { remetente = JSON.parse($input.first().json.remetente || 'null'); } catch (e) {}\nif (!remetente || !remetente.remoteJid) return [];\nconst execucao = erro.execution || {};\nreturn [{ json: {\n  remoteJid: remetente.remoteJid,\n  propriedade_id: remetente.propriedade_id || null,\n  resposta: \"Desculpe, tive um problema no sistema ao processar sua mensagem e ela pode não ter sido registrada. Confira e, se precisar, mande de novo daqui a pouco.\",\n  detalhe: `Falha no nó \"${execucao.lastNodeExecuted || '?'}\": ${(execucao.error && execucao.error.message) || 'erro desconhecido'} (execução ${execucao.id || '?'})`,\n} }];"
